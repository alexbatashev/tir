; ARM64 integer constants use MOVZ for the low halfword and MOVK for each
; remaining halfword. This first partition covers values whose upper 32 bits
; are zero. The unmarked expressions compute the low and high halfwords; the
; kept tree is exactly MoveWideKeep16's formal behavior.

(axiom wide-const-u32
  (consts (v w))
  (root w)
  (where (not (ufits v 16)) (ufits v 32))
  (lhs v)
  (rhs
    (keep (or
      (keep (and
        (and v (not (mul 65535 65536)))
        (keep (not
          (keep (mul
            (keep (zext (const 65535 16) w))
            (keep (zext (const 65536 17) w))))))))
      (keep (mul
        (and (lshr v 16) 65535)
        (keep (zext (const 65536 17) w))))))))

(axiom wide-const-u48
  (consts (v w))
  (root w)
  (where (not (ufits v 32)) (ufits v 48))
  (lhs v)
  (rhs
    (keep (or
      (keep (and
        (and v (not (mul 65535 4294967296)))
        (keep (not
          (keep (mul
            (keep (zext (const 65535 16) w))
            (keep (zext (const 4294967296 33) w))))))))
      (keep (mul
        (and (lshr v 32) 65535)
        (keep (zext (const 4294967296 33) w))))))))

(axiom wide-const-u64
  (consts (v w))
  (root w)
  (where (not (ufits v 48)))
  (lhs v)
  (rhs
    (keep (or
      (keep (and
        (and v (not (mul 65535 281474976710656)))
        (keep (not
          (keep (mul
            (keep (zext (const 65535 16) w))
            (keep (zext (const 281474976710656 49) w))))))))
      (keep (mul
        (and (lshr v 48) 65535)
        (keep (zext (const 281474976710656 49) w))))))))
