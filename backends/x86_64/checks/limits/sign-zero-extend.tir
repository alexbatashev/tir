// RUN: tir mc --march=x86_64 --stage=isel %s | filecheck %s

// Signed extension uses the direct instruction. The zero-extension shift pair's
// constant count uses the immediate form, not the by-`cl` form: a register the
// behavior reads by path (`GPR::rcx`) reads that register's value, leaving a
// constant count to the immediate form.

module {
  func @se(%0: !i32) -> !i64 {
    %1 = extsi %0 : !i64
    return %1
  }
  func @ze(%0: !i32) -> !i64 {
    %1 = extui %0 : !i64
    return %1
  }
  module_end
}

// CHECK-NOT: rcx = 32
// CHECK: x86_64.movsxd
// CHECK: x86_64.shl {{.*}}imm = 32
// CHECK: x86_64.shr {{.*}}imm = 32
