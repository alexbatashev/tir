// RUN: tir mc --march=x86_64 --stage=regalloc %s | filecheck %s

// A two-member f64 argument group that cannot fit after seven direct f64
// parameters is reloaded from the incoming stack area into XMM registers: with
// no frame of its own, the two members sit above the return address.

module {
  %fn_ninth = func.func @ninth(%0: !f64, %1: !f64, %2: !f64, %3: !f64, %4: !f64, %5: !f64, %6: !f64, %7: !tuple<!f64, !f64>) -> !i64 {
    %8 = tuple_get %7 {index = 0} : !f64
    %9 = tuple_get %7 {index = 1} : !f64
    %10 = addf %8, %9 : !f64
    %11 = fptosi %10 : !i64
    func.return %11
  }
  module_end
}

// CHECK: x86_64.movsd_load_disp {dst = %{{[0-9]+}}:xmm{{[0-9]+}}, base = rsp, imm = 8}
// CHECK: x86_64.movsd_load_disp {dst = %{{[0-9]+}}:xmm{{[0-9]+}}, base = rsp, imm = 16}
