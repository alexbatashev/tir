// RUN: tir mc --march=x86_64 --stage=regalloc %s | filecheck %s

// SysV passes the seventh integer argument at rsp before the call. The stable
// frame reserves its 16-byte outgoing area plus eight bytes for call-site
// alignment. Coalescing keeps the shared argument in a caller-saved register.

module {
  %fn_g = func.declare @g(!i64, !i64, !i64, !i64, !i64, !i64, !i64) -> !i64
  %fn_f = func.func @f(%0:!i64) -> !i64 {
    %r = func.call %fn_g(%0, %0, %0, %0, %0, %0, %0 : !i64, !i64, !i64, !i64, !i64, !i64, !i64) -> !i64
    func.return %r
  }
  module_end
}

// CHECK: x86_64.add_imm {dst = rsp, dst_tied = rsp, imm = -24}
// CHECK: x86_64.mov_store_disp {base = rsp, src = %{{[0-9]+}}:{{.*}}, imm = 0}
// CHECK: asm.vcall state(%{{[0-9]+}}, %{{[0-9]+}}) {callee = "g"
// CHECK: x86_64.add_imm {dst = rsp, dst_tied = rsp, imm = 24}
