// RUN: tir mc --march=x86_64 --stage=isel %s | filecheck %s

// A tested loop's body runs under the condition its test yields. That condition
// is spelled over the ports' per-iteration heads, so it holds on every
// iteration, not only the first: the simplifier the lowering prologue runs
// spends it in the body, whose two carried values are therefore equal and whose
// subtraction is the literal zero by the time selection sees it.

module {
  %fn_equal_body = func.func @equal_body(%n: !i64, %acc: !i64) -> !i64 {
    %r = scf.while iter_args(%a = %acc, %i = %n) -> !i64, !i64 {
      %c = cmpi %i, %a {predicate = "eq"} : !i1
      scf.condition %c, %a, %i
    } do scope(%tok)(%ca, %ci) {
      %d = subi %ci, %ca : !i64
      scf.yield %d, %ci
    }
    func.return %r
  }
  module_end
}

// CHECK: x86_64.je
// CHECK-NOT: x86_64.sub
// CHECK: ^bb{{[0-9]+}}(%{{[0-9]+}}: !x86_64.GPR, %{{[0-9]+}}: !x86_64.GPR):
// CHECK-NEXT: x86_64.mov_imm {dst = %[[ZERO:[0-9]+]]:GPR, imm = 0}
// CHECK-NEXT: asm.vbr %[[ZERO]], %{{[0-9]+}} ^bb{{[0-9]+}}
