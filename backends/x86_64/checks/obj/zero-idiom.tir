// RUN: tir mc --march=x86_64 --stage=isel %s | filecheck %s --check-prefix=FORMAL
// RUN: tir mc --march=x86_64 --stage=regalloc %s | filecheck %s --check-prefix=REGALLOC
// RUN: tir mc --march=x86_64 --filetype=obj-ascii %s | filecheck %s

module {
  %fn_zero = func.func @zero() -> !i64 {
    %0 = constant {value = 0} : !i64
    func.return %0
  }
  %fn_zero32 = func.func @zero32() -> !i32 {
    %0 = constant {value = 0} : !i32
    func.return %0
  }
  module_end
}

// FORMAL: x86_64.xor_zero {
// FORMAL: x86_64.xor_zero32
// REGALLOC: x86_64.xor_zero {
// REGALLOC: x86_64.xor_zero32

// CHECK: zero:
// CHECK-NEXT: [0x48, 0x31, 0xC0]
// CHECK-NEXT: [0xC3]
// CHECK: zero32:
// CHECK-NEXT: [0x31, 0xC0]
// CHECK-NEXT: [0xC3]
