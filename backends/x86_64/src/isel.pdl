// x86-64-specific instruction-selection axioms.
//
// x86 has no direct unsigned-integer-to-floating-point conversion. A binary32
// or binary64 unsigned conversion of a 32-bit integer equals the corresponding
// signed conversion of its 64-bit zero-extension, since masking to 32 bits
// clears the sign bit:
//
//   uitofp(x, fp) == sitofp(zext(x, i64), fp)
//
// The extension is the `mov r32, r32` zeroing move (`movzxd`) feeding the
// signed 64-bit SSE conversion. The identities are proved by bit-blasting both
// conversions through the IEEE round-to-nearest circuit.

rule uitofp32-via-sitofp: #uitofp(x: int<N>, 8, 23) : int<32>
  => #sitofp(#zext(x, 64), const<4>(8), const<5>(23))
  where N == 32;

rule uitofp-via-sitofp: #uitofp(x: int<N>, 11, 52) : int<64>
  => #sitofp(#zext(#extract(x, const<6>(31), const<1>(0)), 64), const<4>(11), const<6>(52))
  where N == 32;

rule fptoui32-via-fptosi: #fptoui(x: int<32>, 32) : int<32>
  => #extract(#fptosi(x, const<7>(64)), const<6>(31), const<1>(0));

rule fptoui-via-fptosi: #fptoui(x: int<64>, 32) : int<32>
  => #extract(#fptosi(x, const<7>(64)), const<6>(31), const<1>(0));

