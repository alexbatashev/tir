//! Vector fixed-point arithmetic from the RISC-V Vector extension:
//! saturating add/subtract, saturating multiply, scaling shifts, averaging
//! add/subtract, and narrowing clips.
//!
//! Saturating operations accumulate into the vxsat flag: the per-lane
//! saturation flags are OR-reduced over the active lanes (masked-off lanes
//! contribute nothing) and merged into the CSR. Rounding operations read the
//! vxrm rounding mode through `round_incr`, which implements the spec's
//! get_fixed_rounding_incr: the increment is computed from the bits shifted
//! out, and the select on vxrm is evaluated per lane.

// Bit k of v, panic-free for any k (the shift saturates, so out-of-range
// reads as zero — the branch selecting on such a bit discards it anyway).
fn bit_at(v, k) {
    extract(v >> k, 0, 0)
}

// Whether bits 0..k-2 of v are nonzero, for any k (k < 2 yields a dead value
// that the caller's vxrm select discards).
fn lowbits_nonzero(v, k) {
    if (v & ((zext(0b1, self.XLEN) << (k - zext(0b1, self.XLEN))) - zext(0b1, self.XLEN))) == zext(0b0, self.XLEN) { zext(0b0, 1) } else { zext(0b1, 1) }
}

// The rounding increment of get_fixed_rounding_incr(v, s): round-to-nearest-up
// takes the last bit shifted out; round-to-nearest-even also looks at the
// remaining bits and the retained LSB; round-down never increments; round-to-
// odd increments when anything was shifted out and the retained LSB is clear.
fn round_incr(v, s) {
    if s == zext(0b0, self.XLEN) { zext(0b0, 1) }
    else if VCSR::vxrm == zext(0b00, self.XLEN) { bit_at(v, s - zext(0b1, self.XLEN)) }
    else if VCSR::vxrm == zext(0b01, self.XLEN) { bit_at(v, s - zext(0b1, self.XLEN)) & (bit_at(v, s) | lowbits_nonzero(v, s)) }
    else if VCSR::vxrm == zext(0b10, self.XLEN) { zext(0b0, 1) }
    else { (bit_at(v, s) == zext(0b0, 1)) & lowbits_nonzero(v, s + zext(0b1, self.XLEN)) }
}

// Signed saturation of a `wide`-bit value to SEW bits.
fn sat_signed(x, wide) {
    max = (zext(0b1, wide) << (VCFG::sew - zext(0b1, self.XLEN))) - zext(0b1, wide);
    min = zext(0b0, wide) - (zext(0b1, wide) << (VCFG::sew - zext(0b1, self.XLEN)));
    if x > max { extract(max, (VCFG::sew - zext(0b1, self.XLEN)), 0) } else if x < min { extract(min, (VCFG::sew - zext(0b1, self.XLEN)), 0) } else { extract(x, (VCFG::sew - zext(0b1, self.XLEN)), 0) }
}

// Saturation happened iff truncating to SEW and re-extending loses information.
fn sat_signed_happened(x, wide) {
    if sext(extract(x, (VCFG::sew - zext(0b1, self.XLEN)), 0), wide) == x { zext(0b0, 1) } else { zext(0b1, 1) }
}

// Unsigned saturation of a `wide`-bit value to SEW bits: any bit at or above
// SEW set means the value exceeds the SEW-bit unsigned range.
fn sat_unsigned(x, wide) {
    if extract(x, wide - zext(0b1, self.XLEN), VCFG::sew) == zext(0b0, self.XLEN) { extract(x, (VCFG::sew - zext(0b1, self.XLEN)), 0) } else { sext(0b1, VCFG::sew) }
}

fn sat_unsigned_happened(x, wide) {
    if extract(x, wide - zext(0b1, self.XLEN), VCFG::sew) == zext(0b0, self.XLEN) { zext(0b0, 1) } else { zext(0b1, 1) }
}


instruction VSadduVV for [RVV] : VArithVV {
    param MNEMONIC: String = "vsaddu.vv";
    param FUNCT6: bits<6> = 0b100000;

    behavior {
        vd = concat(map(zip(split(vs2, VCSR::vl, VCFG::sew), split(vs1, VCSR::vl, VCFG::sew)), |a, b| sat_unsigned(zext(a, (VCFG::sew + zext(0b1, self.XLEN))) + zext(b, (VCFG::sew + zext(0b1, self.XLEN))), (VCFG::sew + zext(0b1, self.XLEN)))));
        n = if VCSR::vl == zext(0b0, self.XLEN) { zext(0b1, self.XLEN) } else { VCSR::vl };
                sat = if VCSR::vl == zext(0b0, self.XLEN) { zext(0b0, 1) } else { reduce(map(zip(split(vs2, n, VCFG::sew), split(vs1, n, VCFG::sew)), |a, b| sat_unsigned_happened(zext(a, (VCFG::sew + zext(0b1, self.XLEN))) + zext(b, (VCFG::sew + zext(0b1, self.XLEN))), (VCFG::sew + zext(0b1, self.XLEN)))), |acc, x| acc | x) };
                VCSR::vxsat = VCSR::vxsat | zext(sat, self.XLEN);
    }
}

