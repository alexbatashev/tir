                sat = if VCSR::vl == zext(0b0, self.XLEN) { zext(0b0, 1) } else { reduce(map(zip(split(vs2, n, VCFG::sew), split(vs1, n, VCFG::sew)), |a, b| if a ~< b { zext(0b1, 1) } else { zext(0b0, 1) }), |acc, x| acc | x) };
