// RUN: tir mc --march=rv64i --stage=isel %s | filecheck %s

// A block entered through exactly one guarded edge inherits the guard's fact,
// asserted in an e-graph assumption scope while the block solves. Restructuring
// makes the second guard the test of a gate nested in the first gate's arm, and
// a region's entry fact does not yet reach a nested gate's test: the identical
// compare is re-selected instead of folding to the taken successor. Recovering
// that fold is the one Stage-6 residue this shape shows.

module {
  func @dominated(%0: !i64, %1: !i64) -> !i64 {
    %2 = cmpi %0, %1 {predicate = "slt"} : !i1
    cond_br %2, ^bb1, ^bb2
  ^bb1:
    %3 = cmpi %0, %1 {predicate = "slt"} : !i1
    cond_br %3, ^bb3, ^bb4
  ^bb2:
    %4 = constant {value = 0} : !i64
    return %4
  ^bb3:
    %5 = constant {value = 1} : !i64
    return %5
  ^bb4:
    %6 = constant {value = 2} : !i64
    return %6
  }
  module_end
}

// The entry selects the fused compare-and-branch, and so does the dominated
// block.
// CHECK: riscv.blt {rs1 = %virt[[A:[0-9]+]]:GPR, rs2 = %virt[[B:[0-9]+]]:GPR, imm = ^[[ARM:bb[0-9]+]]}
// CHECK-NEXT: asm.vbr ^bb{{[0-9]+}}
// CHECK: ^[[ARM]]:
// CHECK-NEXT: riscv.blt {rs1 = %virt[[A]]:GPR, rs2 = %virt[[B]]:GPR, imm = ^bb{{[0-9]+}}}
