// RUN: tir mc --march=rv64i --stage=isel %s | filecheck %s

// Two reads of one address on one state chain are one access: the state operand
// is the whole of a memory term's identity, so the loads hash-cons and select a
// single lw. A store in between takes the chain to a different state, so the
// reads around it stay two: the store may write what they read, so nothing in
// the lowering prologue forwards it into the reload either.

module {
  %fn_reload = func.func @reload(%0: !ptr.p<!i32>, %1: !ptr.p<!i32>, %2: !i32) -> !i32 {
    %3 = ptr.load %0 : !i32
    %4 = ptr.load %0 : !i32
    %5 = addi %3, %4 : !i32
    ptr.store %2, %1
    %6 = ptr.load %0 : !i32
    %7 = addi %5, %6 : !i32
    func.return %7
  }
  module_end
}

// CHECK: riscv.lw {rd = %[[FIRST:.*]]:GPR, rs1 = %[[V0:[0-9]+]]:GPR, imm = 0}
// CHECK-NOT: riscv.lw
// CHECK: riscv.addw {rd = %[[SUM:.*]]:GPR, rs1 = %[[FIRST:[0-9]+]]:GPR, rs2 = %[[FIRST:[0-9]+]]:GPR}
// CHECK: riscv.sw {rs1 = %{{[0-9]+}}:GPR, rs2 = %{{[0-9]+}}:GPR, imm = 0}
// CHECK: riscv.lw {rd = %[[RELOADED:.*]]:GPR, rs1 = %[[V0]]:GPR, imm = 0}
// CHECK: riscv.addw {rd = {{.*}}:GPR, rs1 = %[[SUM:[0-9]+]]:GPR, rs2 = %[[RELOADED:[0-9]+]]:GPR}
