// RUN: tir mc --march=rv64ifd --filetype=asm -o /tmp/tir-riscv-fp-ignore-preserves-flags.s %s
// RUN: isasim --march=rv64ifd --entry=main --until-pc=0 --trace-registers-end /tmp/tir-riscv-fp-ignore-preserves-flags.s | filecheck %s --check-prefix=EXEC
// RUN: tir mc --march=rv64ifd --filetype=asm --shuffle-machine-order -o /tmp/tir-riscv-fp-ignore-preserves-flags.s %s
// RUN: isasim --march=rv64ifd --entry=main --until-pc=0 --trace-registers-end /tmp/tir-riscv-fp-ignore-preserves-flags.s | filecheck %s --check-prefix=EXEC

module {
  %fn_main = func.func @main(%denominator: !f64) -> !i64 {
    %env0 = state.entry_state : !state<fp.env>
    %all_flags = constant {value = 31} : !i5
    %env1 = fp.clear_flags %all_flags state(%env0)
    %zero = fp.constant {bits = 0} : !f64
    %unused, %env2 = fp.div %zero, %zero state(%env1) {semantics = {kind = "arithmetic", rounding = "nearest_even", exceptions = "flags", nan = "any_quiet", subnormals = "gradual", tininess = "after_rounding"}} : !f64
    %one = fp.constant {bits = 4607182418800017408} : !f64
    %result = fp.div %one, %denominator {semantics = {kind = "arithmetic", rounding = "nearest_even", exceptions = "ignore", nan = "any_quiet", subnormals = "gradual", tininess = "after_rounding"}} : !f64
    %flags, %env3 = fp.get_flags state(%env2) : !i5
    %bits = bitcast %result : !i64
    %wide_flags = extui %flags : !i64
    %observed = xori %bits, %wide_flags : !i64
    func.return %observed state(%env3)
  }
  module_end
}

// EXEC: final registers:
// EXEC-DAG: GPR[10] = 0x7ff0000000000010
// EXEC-DAG: CSR[1] = 0x10
