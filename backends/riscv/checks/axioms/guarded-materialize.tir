// A proof obligation is an assertion about a match that passed every filter, so
// it is discharged only at widths the axiom can actually fire at. The
// `wide-const-split` materialize axiom is guarded on `!fits(v, 12)` and its
// right-hand side computes `W - 12`, which is undefined at `W = 8`; an 8-bit
// constant always fits a signed 12-bit immediate, so the axiom never applies
// there and must never be proved there.
// RUN: env TIR_VERIFY_AXIOMS=1 tir mc --march=rv64i --stage=isel %s | filecheck %s

module {
  %fn = func.func @narrow_const() -> !i8 {
    %0 = constant {value = 100} : !i8
    func.return %0
  }
  module_end
}

// CHECK: asm.symbol {name = "narrow_const"
