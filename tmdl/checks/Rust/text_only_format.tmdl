// RUN: tmdlc --action=emit-rust --dialect=test --text-only --output=- %s | filecheck %s

isa TextIsa {
    param XLEN: Integer = 32;
}

register_class GPR for [TextIsa] {
    param ENCODING_LEN: Integer = 2;
    param WIDTH: Integer = self.XLEN;

    registers {
        r0..r3 => {                         },
    }
}

template Binary for [TextIsa] {
    param OPNAME: String;
    param MNEMONIC: String;

    operands {
        d: GPR,
        a: GPR,
    }

    asm { "{self.MNEMONIC} {d}, {a}" }
}

instruction Add for [TextIsa] : Binary {
    param OPNAME: String = "add";
    param MNEMONIC: String = "add";
    behavior { todo(); }
}

instruction Sub for [TextIsa] : Binary {
    param OPNAME: String = "sub";
    param MNEMONIC: String = "sub";
    behavior { todo(); }
}

// Every operation prints through the one shared machine-op formatter, which
// reads the register slots from the opcode's `InstrInfo` instead of expanding
// the same register-dispatch loop into every generated operation.
// CHECK: static REGS_ADD
// CHECK: name: "d",
// CHECK: name: "a",
// CHECK: impl AddOp
// CHECK: tir::backend::print_machine_op(fmt, self)
// CHECK: impl SubOp
// CHECK: tir::backend::print_machine_op(fmt, self)
