// A generic CSR read-set with csr=flags and rs1=zero derives a pure flags-read
// rule while retaining the generic instruction's physical register slots.

// RUN: tmdlc --action=emit-rust --dialect=test --output=- %s | filecheck %s

isa Test32 { param XLEN: Integer = 32; }
isa Test64 { param XLEN: Integer = 64; }
isa Floating requires [Test32 | Test64] {}

register_class GPR for [Test32, Test64] {
    param ENCODING_LEN: Integer = 5;
    param WIDTH: Integer = self.XLEN;
    registers {
        x0("zero") => { traits = [hardwired_zero] },
        x1..x31("r{}") => {},
    }
}

register_class CSR for [Test32, Test64] {
    file = CSR;
    param ENCODING_LEN: Integer = 12;
    param WIDTH: Integer = self.XLEN;
    registers { flags => { index = 1 }, }
}

register_class FPR for [Floating] {
    param ENCODING_LEN: Integer = 5;
    param WIDTH: Integer = 64;
    registers { f0..f31 => { traits = [float] }, }
}

register_class FLAGS for [Floating] {
    file = CSR;
    param ENCODING_LEN: Integer = 12;
    param WIDTH: Integer = 5;
    registers { flags => { index = 1, traits = [status_flag] }, }
}

instruction RoundedAdd for [Floating] {
    param MNEMONIC: String = "fadd";
    operands { rd: FPR, a: FPR, b: FPR, }
    encoding { 0b0000000, b, a, 0b000, rd, 0b1010011 }
    asm { "fadd {rd}, {a}, {b}" }
    behavior {
        let result = fadd(a, b, 0b000);
        FLAGS::flags = FLAGS::flags | fp_flags(result);
        rd = result;
    }
}

fn csr_read(address, value) {
    if address == 0x001 {
        zext(FLAGS::flags, self.XLEN)
    } else {
        value
    }
}

instruction CSRReadSet for [Test32, Test64] {
    param MNEMONIC: String = "csrrs";
    operands { rd: GPR, csr: CSR, rs1: GPR, }
    encoding { csr, rs1, 0b010, rd, 0b1110011 }
    asm { "csrrs {rd}, {csr}, {rs1}" }
    behavior {
        old = csr_read(regnum(csr), csr);
        value = old | rs1;
        rd = old;
        if regnum(rs1) != zext(0b0, 5) {
            csr = value;
        }
    }
}

instruction CSRReadWrite for [Test32, Test64] {
    param MNEMONIC: String = "csrrw";
    operands { rd: GPR, csr: CSR, rs1: GPR, }
    encoding { csr, rs1, 0b001, rd, 0b1110011 }
    asm { "csrrw {rd}, {csr}, {rs1}" }
    behavior {
        value = rs1;
        rd = csr_read(regnum(csr), csr);
        if regnum(csr) == 0x001 {
            FLAGS::flags = extract(value, 4, 0);
        } else {
            csr = value;
        }
    }
}

// CHECK: SymKind::StateRead
// CHECK: static EMIT_CSRREADSET{{[^:]*}}:
// CHECK: op: ("test", "csrrs"),
// CHECK: tir::backend::isel::EmitAttr::Result {
// CHECK-NEXT: attr: "rd",
// CHECK: tir::backend::isel::EmitAttr::Physical {
// CHECK-NEXT: attr: "csr",
// CHECK-NEXT: class: RegClass::CSR.id(),
// CHECK-NEXT: index: 1,
// CHECK: tir::backend::isel::EmitAttr::Physical {
// CHECK-NEXT: attr: "csr_tied",
// CHECK-NEXT: class: RegClass::CSR.id(),
// CHECK-NEXT: index: 1,
// CHECK: tir::backend::isel::EmitAttr::Physical {
// CHECK-NEXT: attr: "rs1",
// CHECK-NEXT: class: RegClass::GPR.id(),
// CHECK-NEXT: index: 0,
// CHECK: static RULE_CSRREADSET{{[^:]*}}:
// CHECK: tir::backend::isel::FeatureClause::Any(&[Feature::Floating as u16]),
// CHECK: tir::backend::isel::FeatureClause::Any(
// CHECK-NEXT: &[Feature::Test32 as u16, Feature::Test64 as u16],
// CHECK: states: &[tir::builtin::StateResource::FpEnv],
// CHECK: registers: &[],

// CHECK: static RULE_{{[^:]*}}_XLEN32_{{[^:]*}}: tir::backend::isel::RuleSpec =
// CHECK: tir::backend::isel::FeatureClause::Any(&[Feature::Floating as u16]),
// CHECK: tir::backend::isel::FeatureClause::Any(&[Feature::Test32 as u16]),
// CHECK: tir::backend::isel::FeatureClause::None(&[Feature::Test64 as u16]),
// CHECK: static RULE_{{[^:]*}}_XLEN64_{{[^:]*}}: tir::backend::isel::RuleSpec =
// CHECK: tir::backend::isel::FeatureClause::Any(&[Feature::Floating as u16]),
// CHECK: tir::backend::isel::FeatureClause::Any(&[Feature::Test64 as u16]),
// CHECK-NOT: tir::backend::isel::FeatureClause::None
// CHECK: pattern:
