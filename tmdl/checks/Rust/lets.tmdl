// A `let` binding is evaluated once, at its statement, and parked in the symbol
// table; later statements read that symbol instead of rebuilding the term. The
// programs themselves live in the sem blob, so their shape is checked by
// tmdl/tests/sem_blob.rs; here only the emitted Rust around them is checked.

// RUN: tmdlc --action=emit-rust --dialect=test --output=- %S/../Inputs/lets.tmdl | filecheck %s

// CHECK: impl tir::backend::MachineInstruction for AddDoubleOp
// CHECK: __tmdl_entry_syms[2] = match value
// CHECK: write_register_value

// CHECK: impl tir::backend::MachineInstruction for AmoAddWLetOp
// CHECK: __tmdl_entry_syms[2] = match value
// CHECK: write_register_value

// CHECK: impl tir::backend::MachineInstruction for LoadTwiceOp
// CHECK: __tmdl_entry_syms[1] = match value
// CHECK: write_register_value

// CHECK: impl tir::backend::MachineInstruction for AmoAddDBareOp
// CHECK: __tmdl_entry_syms[2] = match value
// CHECK: write_register_value

// Selection patterns see through a binding: the op semantics is the underlying
// expression over the operands, not an opaque binding symbol.
// CHECK: impl tir::sem::AsSemExpr for AddDoubleOp
