// RUN: tir opt --pass fixpoint<3>(func.func(instcombine)) %s | filecheck %s

// A fixpoint is spelled in the pipeline grammar, so the fuzzer and every check
// can name a round exactly as the driver runs it.

module {
  %fn_f = func.func @f(%0: !i32) -> !i32 {
    %1 = constant {value = 0} : !i32
    %2 = addi %0, %1 : !i32
    %3 = addi %2, %1 : !i32
    func.return %3
  }
  module_end
}

// CHECK-LABEL: %{{[0-9]+}} = func.func @f
// CHECK-NOT: addi
// CHECK: func.return %0
