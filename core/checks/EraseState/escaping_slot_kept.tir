// RUN: tir opt --pass erase-state --verify %s | filecheck %s

// A slot whose address reaches a call can be read from anywhere, so what its
// stores left behind is observable and the slot stays even with no read of its own.

module {
  declare @sink(!ptr.p<!i32>) -> !unit
  func @f(%0: !i32) {
    %1 = ptr.alloca {size = 4, align = 4} : !ptr.p<!i32>
    ptr.store %0, %1
    call @sink(%1 : !ptr.p<!i32>)
    return
  }
  module_end
}

// CHECK-LABEL: func @f
// CHECK-NEXT: %1 = ptr.alloca {size = 4, align = 4} : !ptr.p<!i32>
// CHECK-NEXT: ptr.store %0, %1
// CHECK-NEXT: call @sink(%1 : !ptr.p<!i32>)
