// RUN: tir opt --pass thread-state --pass erase-state --verify %s | filecheck --implicit-check-not state %s

// Nested ports unwind inside out: the gate's ports go, and so does the loop's
// carried one that fed them.

module {
  func @h(%0: !index, %1: !index, %2: !index, %3: !i1, %4: !i32) -> !i32 {
    %5 = ptr.alloca {size = 4, align = 4} : !ptr.p<!i32>
    ptr.store %4, %5
    scf.for %0, %1, %2 {
      scf.if %3 {
        ptr.store %4, %5
        scf.yield
      } else {
        scf.yield
      }
      scf.yield
    }
    %6 = ptr.load %5 : !i32
    return %6
  }
  module_end
}

// CHECK-LABEL: func @h(%0: !index, %1: !index, %2: !index, %3: !i1, %4: !i32) -> !i32 {
// CHECK-NEXT: %5 = ptr.alloca {size = 4, align = 4} : !ptr.p<!i32>
// CHECK-NEXT: ptr.store %4, %5
// CHECK-NEXT: scf.for %0, %1, %2 {
// CHECK-NEXT: scf.if %3 {
// CHECK-NEXT: ptr.store %4, %5
// CHECK-NEXT: scf.yield
// CHECK-NEXT: }
// CHECK-NEXT: else {
// CHECK-NEXT: scf.yield
// CHECK-NEXT: }
// CHECK-NEXT: scf.yield
// CHECK-NEXT: }
// CHECK-NEXT: %6 = ptr.load %5 : !i32
// CHECK-NEXT: return %6
// CHECK-NEXT: }
