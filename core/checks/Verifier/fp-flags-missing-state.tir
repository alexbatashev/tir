// RUN: not tir opt --verify %s 2>&1 | filecheck %s

module {
  %f = func.func @main(%a: !f64, %b: !f64) -> !f64 {
    %value = fp.add %a, %b {semantics = {kind = "arithmetic", rounding = "nearest_even", exceptions = "flags", nan = "any_quiet", subnormals = "gradual", tininess = "after_rounding"}} : !f64
    -> %value
  }
  module_end
}

// CHECK: floating operation state ports do not match its semantics
