// RUN: tir opt --verify --pass verify-deps %s | filecheck %s

module {
  %f = func.func @main(%condition: !i1) -> !fp.rounding {
    %env0 = state.entry_state : !state<fp.env>
    %nearest = fp.rounding_constant {mode = "nearest_even"} : !fp.rounding
    %mode, %env1 = scf.switch %condition args(%env0) (%left) {
      %read, %next = fp.get_round state(%left) : !fp.rounding
      -> %read, %next
    }
    (%right) {
      -> %nearest, %right
    }
    -> %mode, %env1
  }
  module_end
}

// CHECK: scf.switch
// CHECK: fp.get_round
