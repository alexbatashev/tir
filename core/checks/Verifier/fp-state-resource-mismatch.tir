// RUN: not tir opt --verify %s 2>&1 | filecheck %s

module {
  %fn_bad = func.func @bad() {
    %memory = state.entry_state : !state<memory>
    %mask = constant {value = 1} : !i5
    %next = fp.clear_flags %mask state(%memory)
    func.return state(%next)
  }
  module_end
}

// CHECK: floating operation has a mismatched state resource
