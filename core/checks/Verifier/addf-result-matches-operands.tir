// RUN: not tir opt --verify %s

// fp.add requires its result to share the operand type; f32 operands with an f64
// result fails.

module {
  %fn_f = func.func @f() -> !f64 {
    %0 = fp.constant {bits = 1069547520} : !f32
    %1 = fp.constant {bits = 1075838976} : !f32
    %2 = fp.add %0, %1 {semantics = {exceptions = "ignore", kind = "arithmetic", nan = "any_quiet", rounding = "nearest_even", subnormals = "gradual", tininess = "after_rounding"}} : !f64
    func.return %2
  }
  module_end
}
