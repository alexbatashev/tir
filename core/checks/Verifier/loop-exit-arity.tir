// RUN: not tir opt --verify %s 2>&1 | filecheck %s

// A body naming fewer values than the loop carries leaves a port without an
// exit value.

module {
  %fn_main = func.func @main(%0: !i32) -> !i32 {
    %1 = scf.loop (%2 = %0) {
      %3 = constant {value = 0} : !i1
      -> %3, %2
    }
    func.return %1
  }
  module_end
}

// CHECK: scf.loop carries 1 values but has 0 exit values
