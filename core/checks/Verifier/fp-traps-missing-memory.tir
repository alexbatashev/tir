// RUN: not tir opt --verify %s 2>&1 | filecheck %s

module {
  %f = func.func @main(%a: !f64, %b: !f64) -> !f64 {
    %env = state.entry_state : !state<fp.env>
    %value, %next = fp.add %a, %b state(%env) {semantics = {kind = "arithmetic", rounding = "nearest_even", exceptions = "flags_and_traps", nan = "any_quiet", subnormals = "gradual", tininess = "after_rounding"}} : !f64
    -> %value, %next
  }
  module_end
}

// CHECK: floating operation state ports do not match its semantics
