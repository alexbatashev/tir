// RUN: not tir opt --verify %s 2>&1 | filecheck %s

// Floating-environment reads return the next state in one executed chain, so
// two reads cannot fork one environment into independently writable futures.

module {
  %f = func.func @main() -> !fp.rounding {
    %s0 = state.entry_state : !state<fp.env>
    %r1, %s1 = fp.get_round state(%s0) : !fp.rounding
    %r2, %s2 = fp.get_round state(%s0) : !fp.rounding
    %up = fp.rounding_constant {mode = "toward_positive"} : !fp.rounding
    %down = fp.rounding_constant {mode = "toward_negative"} : !fp.rounding
    %s3 = fp.set_round %up state(%s1)
    %s4 = fp.set_round %down state(%s2)
    -> %r1, %s3, %s4
  }
  module_end
}

// CHECK: state %{{[0-9]+}} has incompatible concurrent uses
