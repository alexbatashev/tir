// RUN: not tir opt --verify %s 2>&1 | filecheck %s

module {
  %fn_f = func.func @f(%input: !f64) -> !f32 {
    %result = fp.convert %input {semantics = {exceptions = "ignore", kind = "arithmetic", nan = "any_quiet", rounding = "nearest_even", subnormals = "gradual", tininess = "before_rounding"}} : !f32
    func.return %result
  }
  module_end
}

// CHECK: fp arithmetic supports gradual subnormals and tininess after rounding
