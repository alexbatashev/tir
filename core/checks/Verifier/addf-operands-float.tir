// RUN: not tir opt --verify %s

// fp.add requires float operands; integer operands fail verification even when
// the annotated result type is a float.

module {
  %fn_f = func.func @f() -> !f32 {
    %0 = constant {value = 1} : !i32
    %1 = constant {value = 2} : !i32
    %2 = fp.add %0, %1 {semantics = {exceptions = "ignore", kind = "arithmetic", nan = "any_quiet", rounding = "nearest_even", subnormals = "gradual", tininess = "after_rounding"}} : !f32
    func.return %2
  }
  module_end
}
