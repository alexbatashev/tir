// RUN: tir interp %s | filecheck %s
// RUN: tir opt --pass lower-intrinsics --verify %s | tir interp | filecheck %s
// RUN: tir opt --pass restructure-nodes --pass lower-intrinsics --pass verify-deps --verify %s | tir interp | filecheck %s

// Distinct source bytes expose a wrong tail offset; the eighth destination byte
// must remain unchanged when two four-byte accesses copy seven bytes.
module {target_env = {memory_scalar_bytes = [1, 2, 4, 8]}} {
  %main = func.func @main() -> !i64 {
    %src = ptr.alloca {size = 8, align = 1} : !ptr.p
    %dst = ptr.alloca {size = 8, align = 1} : !ptr.p
    %pattern = constant {value = 578437695752307201} : !i64
    ptr.store %pattern, %src
    %sentinel = constant {value = 72057594037927936} : !i64
    ptr.store %sentinel, %dst
    %n = constant {value = 7} : !i64
    ptr.memcpy %dst, %src, %n
    %result = ptr.load %dst : !i64
    func.return %result
  }
  module_end
}

// CHECK: i64 74034537486811649
