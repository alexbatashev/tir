// RUN: tir opt --pass restructure-nodes --verify %s | filecheck %s

// The slot's address reaches a call, so its contents may be observed from
// anywhere: its chain is joined with the world chain at the store and at the
// call, and the load after the call reads the state the call left.

module {
  %fn_sink = func.declare @sink(!ptr.p<!i32>) -> !unit
  %fn_f = func.func @f(%0: !i32) -> !i32 {
    %1 = ptr.alloca {size = 4, align = 4} : !ptr.p<!i32>
    ptr.store %0, %1
    func.call %fn_sink(%1 : !ptr.p<!i32>)
    %2 = ptr.load %1 : !i32
    func.return %2
  }
  module_end
}
// CHECK-LABEL: %{{[0-9]+}} = func.func @f
// CHECK-NEXT: %[[SLOT:[0-9]+]] = ptr.alloca {size = 4, align = 4} : !ptr.p<!i32>
// CHECK-NEXT: | %[[E0:[0-9]+]] = state.entry_state
// CHECK-NEXT: | %[[E1:[0-9]+]] = state.entry_state
// CHECK-NEXT: | %[[J1:[0-9]+]] = state.join | %[[E0]], %[[E1]]
// CHECK-NEXT: | %[[S1:[0-9]+]] = ptr.store %{{[0-9]+}}, %[[SLOT]] | %[[J1]]
// CHECK-NEXT: | %[[P0:[0-9]+]], %[[P1:[0-9]+]] = state.split | %[[S1]]
// CHECK-NEXT: | %[[J2:[0-9]+]] = state.join | %[[P1]], %[[P0]]
// CHECK-NEXT: | %[[S2:[0-9]+]] = func.call %{{[0-9]+}}(%[[SLOT]] : !ptr.p<!i32>) | %[[J2]]
// CHECK-NEXT: | %[[Q0:[0-9]+]], %[[Q1:[0-9]+]] = state.split | %[[S2]]
// CHECK-NEXT: %[[VAL:[0-9]+]] | %[[S3:[0-9]+]] = ptr.load %[[SLOT]] | %[[Q1]] : !i32
// CHECK-NEXT: | %[[EXIT:[0-9]+]] = state.join | %[[S3]], %[[Q0]]
// CHECK-NEXT: -> %[[VAL]] | %[[EXIT]]
