// RUN: tir opt --pass thread-state --verify %s | filecheck %s

// A conditional's arms take no arguments, so a chain crossing the gate would have
// to be named by both arms — and state is linear. Until a γ can carry state, a
// function whose gates touch memory is left as it was rather than threaded in
// part.

module {
  func @h(%0: !i1, %1: !i32) -> !i32 {
    %2 = ptr.alloca {size = 4, align = 4} : !ptr.p<!i32>
    ptr.store %1, %2
    scf.if %0 {
      ptr.store %1, %2
      scf.yield
    } else {
      scf.yield
    }
    %3 = ptr.load %2 : !i32
    return %3
  }
  module_end
}

// CHECK-LABEL: func @h
// CHECK-NOT: entry_state
// CHECK-NOT: state(
