// RUN: tir opt --pass restructure-nodes,verify-deps --verify %s | filecheck %s

// Two globals and two calls back to back. Both calls cross all three chains,
// so the state the first one leaves already stands for the memory the second
// one takes: naming the three chains again between them would only be undone
// by the join the second call takes. One join before the pair and one split
// after it say everything two of each would.

module {
  %g = global @g size 4 align 4
  %h = global @h size 4 align 4
  %fn_k = func.declare @k() -> !unit
  %fn_f = func.func @f(%v: !i32) -> !i32 {
    ptr.store %v, %g
    func.call %fn_k()
    func.call %fn_k()
    %y = ptr.load %h : !i32
    func.return %y
  }
  module_end
}

// CHECK: %{{[0-9]+}} = func.func @f(%[[V:[0-9]+]]: !i32) -> !i32 {
// CHECK: | %[[ENTRY:[0-9]+]] = state.entry_state
// CHECK-NEXT: | %[[EG:[0-9]+]], %[[EH:[0-9]+]], %[[EW:[0-9]+]] = state.split | %[[ENTRY]]
// CHECK-NEXT: | %[[J0:[0-9]+]] = state.join | %[[EG]], %[[EW]]
// CHECK-NEXT: | %[[SG:[0-9]+]] = ptr.store %[[V]], %{{[0-9]+}} | %[[J0]]
// CHECK-NEXT: | %[[PG:[0-9]+]], %[[PW:[0-9]+]] = state.split | %[[SG]]
// CHECK-NEXT: | %[[J1:[0-9]+]] = state.join | %[[PW]], %[[PG]], %[[EH]]
// CHECK-NEXT: | %[[C1:[0-9]+]] = func.call %{{[0-9]+}}() | %[[J1]]
// CHECK-NEXT: | %[[C2:[0-9]+]] = func.call %{{[0-9]+}}() | %[[C1]]
// CHECK-NEXT: | %{{[0-9]+}}, %{{[0-9]+}}, %[[QH:[0-9]+]] = state.split | %[[C2]]
// CHECK-NEXT: %[[Y:[0-9]+]] | %{{[0-9]+}} = ptr.load %{{[0-9]+}} | %[[QH]] : !i32
