// RUN: tir opt --pass restructure-nodes,verify-deps --verify %s | filecheck %s

// A private slot, a global and a call. The slot's address never leaves its own
// accesses, so nothing the outside can reach names it and the call is not on
// its chain: the read of the slot observes the write to it directly. The
// global is a chain of its own between calls, and the call joins it with the
// memory of unknown provenance and splits both back out.

module {
  %g = global @g size 4 align 4
  %fn_h = func.declare @h() -> !unit
  %fn_f = func.func @f(%v: !i32) -> !i32 {
    %a = ptr.alloca {size = 4, align = 4} : !ptr.p<!i32>
    ptr.store %v, %a
    ptr.store %v, %g
    func.call %fn_h()
    %x = ptr.load %a : !i32
    %y = ptr.load %g : !i32
    %s = addi %x, %y : !i32
    func.return %s
  }
  module_end
}

// CHECK: %{{[0-9]+}} = func.func @f(%[[V:[0-9]+]]: !i32) -> !i32 {
// CHECK: | %[[EA:[0-9]+]] = state.entry_state
// CHECK-NEXT: | %[[SA:[0-9]+]] = ptr.store %[[V]], %[[A:[0-9]+]] | %[[EA]]
// CHECK-NEXT: %{{[0-9]+}} | %[[RA:[0-9]+]] = ptr.load %[[A]] | %[[SA]] : !i32
// CHECK-NEXT: | %[[EG:[0-9]+]] = state.entry_state
// CHECK-NEXT: | %[[EW:[0-9]+]] = state.entry_state
// CHECK-NEXT: | %[[IN:[0-9]+]] = state.join | %[[EG]], %[[EW]]
// CHECK-NEXT: | %[[SG:[0-9]+]] = ptr.store %[[V]], %{{[0-9]+}} | %[[IN]]
// CHECK-NEXT: | %[[G1:[0-9]+]], %[[W1:[0-9]+]] = state.split | %[[SG]]
// CHECK-NEXT: | %[[CIN:[0-9]+]] = state.join | %[[W1]], %[[G1]]
// CHECK-NEXT: | %[[C:[0-9]+]] = func.call %{{[0-9]+}}() | %[[CIN]]
// CHECK-NEXT: | %[[W2:[0-9]+]], %[[G2:[0-9]+]] = state.split | %[[C]]
// CHECK-NEXT: %{{[0-9]+}} | %[[RG:[0-9]+]] = ptr.load %{{[0-9]+}} | %[[G2]] : !i32
