// RUN: tir opt --pass thread-state --pass instcombine --pass erase-state --verify %s | filecheck %s

// Nothing stores before the gate, so the read distributed into the arm that
// stores nothing forwards from no store. With no operation naming an
// indeterminate value, that read is the value: it is emitted in the arm, on the
// state reaching the arm's terminator, and the arm yields what it reads. The
// allocation therefore survives, and with it the store the other arm makes.

module {
  func @guarded(%0: !i1, %1: !i32) -> !i32 {
    %2 = ptr.alloca {size = 4, align = 4} : !ptr.p<!i32>
    scf.if %0 {
      ptr.store %1, %2
      scf.yield
    } else {
      scf.yield
    }
    %3 = ptr.load %2 : !i32
    return %3
  }
  module_end
}

// CHECK-LABEL: func @guarded
// CHECK-NEXT: %[[SLOT:[0-9]+]] = ptr.alloca
// CHECK-NEXT: %[[RESULT:[0-9]+]] = scf.if %0 -> !i32 {
// CHECK-NEXT: ptr.store %1, %[[SLOT]]
// CHECK-NEXT: scf.yield %1
// CHECK-NEXT: }
// CHECK: else {
// CHECK-NEXT: %[[UNINIT:[0-9]+]] = ptr.load %[[SLOT]]
// CHECK-NEXT: scf.yield %[[UNINIT]]
// CHECK-NEXT: }
// CHECK-NEXT: return %[[RESULT]]
