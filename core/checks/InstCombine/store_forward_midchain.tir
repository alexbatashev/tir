// RUN: tir opt --pass instcombine %s | filecheck %s

// The load sits mid-chain: it publishes a state a later store reads. A read
// leaves memory as it found it, so that state is the one it read, and once its
// value is the value the store wrote the load has nothing left to do. Nothing
// then reads what the first write left, and the second overwrites its extent,
// so the second is the only write the function makes.

module {
  %fn_f = func.func @f(%0: !ptr.p<!i32>, %1: !i32, %2: !i32) -> !i32 {
    %3 = state.entry_state : !state
    ptr.store %1, %0 state(%3 -> %4)
    %5 = ptr.load %0 : !i32 state(%4 -> %6)
    ptr.store %2, %0 state(%6 -> %7)
    func.return %5 state(%7)
  }
  module_end
}

// CHECK-LABEL: %{{[0-9]+}} = func.func @f
// CHECK: %[[ENTRY:[0-9]+]] = state.entry_state
// CHECK-NEXT: ptr.store %2, %0 state(%[[ENTRY]] -> %[[S:[0-9]+]])
// CHECK-NEXT: func.return %1 state(%[[S]])
// CHECK-NOT: ptr.load
