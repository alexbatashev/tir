// RUN: tir opt --pass thread-state --pass instcombine --pass erase-state --verify %s | filecheck %s

// A body leaving through `scf.break` never reaches its yield, so the state the
// loop leaves is not the one the θ over the latch names. The loop seeds no θ and
// the slot stays in memory.

module {
  func @early(%0: !i1, %1: !i32) -> !i32 {
    %2 = ptr.alloca {size = 4, align = 4} : !ptr.p<!i32>
    ptr.store %1, %2
    scf.while {
      scf.condition %0
    } do scope(%3) {
      ptr.store %1, %2
      scf.break %3
    }
    %4 = ptr.load %2 : !i32
    return %4
  }
  module_end
}

// CHECK-LABEL: func @early
// CHECK: ptr.alloca
// CHECK: ptr.store
// CHECK: scf.while
// CHECK: ptr.store
// CHECK: scf.break
// CHECK: ptr.load
