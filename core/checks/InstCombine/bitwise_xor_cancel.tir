// RUN: tir opt --pass restructure-nodes,instcombine-nodes --verify %s | filecheck %s
// RUN: tir interp %s -f xor_split_cancel --args=7,11,21 | filecheck %s --check-prefix=VALUE
// RUN: tir opt --pass restructure-nodes,instcombine-nodes --verify %s | tir interp -f xor_split_cancel --args=7,11,21 | filecheck %s --check-prefix=VALUE

module {
  %f8 = func.func @xor_cancel_8(%x: !i8, %y: !i8, %z: !i8) -> !i8 {
    %a = xori %x, %y : !i8
    %r = xori %a, %y : !i8
    func.return %r
  }
  %f32 = func.func @xor_cancel_32(%x: !i32, %y: !i32, %z: !i32) -> !i32 {
    %a = xori %x, %y : !i32
    %r = xori %a, %y : !i32
    func.return %r
  }
  %f64 = func.func @xor_cancel_64(%x: !i64, %y: !i64, %z: !i64) -> !i64 {
    %a = xori %x, %y : !i64
    %r = xori %a, %y : !i64
    func.return %r
  }
  %split = func.func @xor_split_cancel(%x: !i32, %y: !i32, %z: !i32) -> !i32 {
    %l = xori %x, %y : !i32
    %r = xori %z, %y : !i32
    %result = xori %l, %r : !i32
    func.return %result
  }
  module_end
}

// CHECK-LABEL: func.func @xor_cancel_8(%[[X8:[0-9]+]]: !i8, %[[Y8:[0-9]+]]: !i8, %[[Z8:[0-9]+]]: !i8)
// CHECK-NEXT: -> %[[X8]]
// CHECK-LABEL: func.func @xor_cancel_32(%[[X32:[0-9]+]]: !i32, %[[Y32:[0-9]+]]: !i32, %[[Z32:[0-9]+]]: !i32)
// CHECK-NEXT: -> %[[X32]]
// CHECK-LABEL: func.func @xor_cancel_64(%[[X64:[0-9]+]]: !i64, %[[Y64:[0-9]+]]: !i64, %[[Z64:[0-9]+]]: !i64)
// CHECK-NEXT: -> %[[X64]]

// CHECK-LABEL: func.func @xor_split_cancel(%[[SPLIT_X:[0-9]+]]: !i32, %[[SPLIT_Y:[0-9]+]]: !i32, %[[SPLIT_Z:[0-9]+]]: !i32)
// CHECK-NEXT: %[[SPLIT_R:[0-9]+]] = xori %[[SPLIT_X]], %[[SPLIT_Z]] : !i32
// CHECK-NEXT: -> %[[SPLIT_R]]
// VALUE: !i32 18
