// RUN: tir opt --pass func.func(restructure-nodes,promote-nodes,instcombine-nodes) --verify %s | filecheck %s

// The slot's address reaches the call, so the call is on the chain the slot's
// accesses are on and the facts model nothing about what it does to memory: it
// may read the first write back.

#data_layout = {types = {i32 = {abi = 32, size = 32}, i64 = {abi = 64, size = 64}, p = {abi = 64, size = 64}}}

module {data_layout = #data_layout} {
  %fn_g = func.declare @g(!ptr.p<!i32>) -> !unit
  %fn_f = func.func @f(%0: !i32, %1: !i32) {
    %2 = ptr.alloca {size = 4, align = 4} : !ptr.p<!i32>
    ptr.store %0, %2
    func.call %fn_g(%2 : !ptr.p<!i32>)
    ptr.store %1, %2
    func.return
  }
  module_end
}

// CHECK-LABEL: %{{[0-9]+}} = func.func @f
// CHECK: | %[[A1:[0-9]+]] = ptr.store %{{[0-9]+}}, %[[SLOT:[0-9]+]] | %{{[0-9]+}}
// CHECK-NEXT: | %[[W1:[0-9]+]], %[[O1:[0-9]+]] = state.split | %[[A1]]
// CHECK-NEXT: | %[[J1:[0-9]+]] = state.join | %[[O1]], %[[W1]]
// CHECK-NEXT: | %[[A2:[0-9]+]] = func.call %{{[0-9]+}}(%[[SLOT]] : !ptr.p<!i32>) | %[[J1]]
// CHECK-NEXT: | %[[W2:[0-9]+]], %[[O2:[0-9]+]] = state.split | %[[A2]]
// CHECK-NEXT: | %[[J2:[0-9]+]] = state.join | %[[O2]], %[[W2]]
// CHECK-NEXT: | %{{[0-9]+}} = ptr.store %{{[0-9]+}}, %[[SLOT]] | %[[J2]]
