// RUN: tir opt --pass instcombine %s | filecheck %s

// The load between the two writes names the extent the first one wrote, so it
// is answered with the value that write stored and goes. What is left is a
// write nothing reads under a write of the same extent, and the second is the
// one the function makes. A read that survives keeps the write it reads —
// `dse_read_fork_off_a_read` is that case.

module {
  %fn_f = func.func @f(%0: !ptr.p<!i32>, %1: !i32, %2: !i32) -> !i32 {
    %3 = state.entry_state : !state
    ptr.store %1, %0 state(%3 -> %4)
    %5 = ptr.load %0 : !i32 state(%4 -> %6)
    ptr.store %2, %0 state(%6 -> %7)
    func.return %5 state(%7)
  }
  module_end
}

// CHECK-LABEL: %{{[0-9]+}} = func.func @f
// CHECK: %[[ENTRY:[0-9]+]] = state.entry_state
// CHECK-NEXT: ptr.store %2, %0 state(%[[ENTRY]] -> %{{[0-9]+}})
// CHECK-NOT: ptr.store %1,
