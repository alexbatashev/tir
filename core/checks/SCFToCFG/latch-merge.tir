// RUN: tir opt --pass builtin.func(scf-to-cfg) %s | filecheck %s

// A loop latch is entered only from the body it closes, so the induction step
// lands in the body block itself instead of a block of its own.

module {
  func @count(%0: !index, %1: !index, %2: !index) -> !i32 {
    %3 = constant {value = 0} : !i32
    %4 = scf.for %0, %1, %2 iter_args(%5 = %3) -> !i32 {
      %6 = addi %5, %3 : !i32
      scf.yield %6
    }
    return %4
  }
  module_end
}

// CHECK-NOT: scf.
// CHECK: br ^[[HEADER:bb[0-9]+]](%{{[0-9]+}}, %{{[0-9]+}} : !index, !i32)
// CHECK: ^[[HEADER]](%[[INDEX:[0-9]+]]: !index, %{{[0-9]+}}: !i32):
// CHECK: cond_br %{{[0-9]+}}, ^[[BODY:bb[0-9]+]](%{{[0-9]+}} : !i32), ^bb{{[0-9]+}}(%{{[0-9]+}} : !i32)
// CHECK-NEXT: ^[[BODY]](%[[CARRY:[0-9]+]]: !i32):
// CHECK-NEXT: %[[NEXT:[0-9]+]] = addi %[[CARRY]], %{{[0-9]+}} : !i32
// CHECK-NEXT: %[[STEP:[0-9]+]] = addi %[[INDEX]], %{{[0-9]+}} : !index
// CHECK-NEXT: br ^[[HEADER]](%[[STEP]], %[[NEXT]] : !index, !i32)
