// RUN: tir opt --pass builtin.func(scf-to-cfg) %s | filecheck %s

// Every carried port becomes a block argument threaded through the header, the
// body and the continuation.

module {
  func @count(%0: !index, %1: !index, %2: !index) -> !i32 {
    %3 = constant {value = 0} : !i32
    %4 = constant {value = 1} : !i64
    %5, %6 = scf.for %0, %1, %2 iter_args(%7 = %3, %8 = %4) -> !i32, !i64 {
      %9 = addi %7, %3 : !i32
      %10 = addi %8, %4 : !i64
      scf.yield %9, %10
    }
    return %5
  }
  module_end
}

// CHECK-NOT: scf.
// CHECK: br ^bb{{[0-9]+}}(%{{[0-9]+}}, %{{[0-9]+}}, %{{[0-9]+}} : !index, !i32, !i64)
// CHECK: cond_br %{{[0-9]+}}, ^bb{{[0-9]+}}(%{{[0-9]+}}, %{{[0-9]+}} : !i32, !i64), ^bb{{[0-9]+}}(%{{[0-9]+}}, %{{[0-9]+}} : !i32, !i64)
// CHECK: return
