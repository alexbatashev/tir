// RUN: tir opt --pass builtin.func(scf-to-cfg) %s | filecheck %s

// The block joining an `scf.if` holds the conditional's result in a parameter,
// and lowering the loop that follows leaves a branch as the join block's only
// operation. It is not a jump-only block: the loop body still reads the
// parameter, so folding the edges past it would erase the value's definition.

module {
  func @f(%0: !i1, %1: !i32) -> !i32 {
    %2 = scf.if %0 -> !i32 {
      scf.yield %1
    } else {
      scf.yield %1
    }
    %3 = scf.while iter_args(%4 = %2) -> !i32 {
      scf.condition %0, %4
    } do scope(%5)(%6) {
      %7 = addi %6, %2 : !i32
      scf.yield %7
    }
    return %3
  }
  module_end
}

// CHECK-NOT: scf.
// CHECK: cond_br %{{[0-9]+}}, ^[[JOIN:bb[0-9]+]](%{{[0-9]+}} : !i32), ^bb{{[0-9]+}}(%{{[0-9]+}} : !i32)
// CHECK-NEXT: ^[[JOIN]](%[[CHOSEN:[0-9]+]]: !i32):
// CHECK: addi %{{[0-9]+}}, %[[CHOSEN]]
