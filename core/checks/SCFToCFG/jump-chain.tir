// RUN: tir opt --pass builtin.func(scf-to-cfg) %s | filecheck %s

// Structuring an `scf.if` inside a loop body leaves both arms branching to an
// exit block that only branches on to the loop header. Those jump-only blocks
// are folded into their predecessors, so the lowered function holds exactly the
// header, the body and the loop's continuation.

module {
  func @loop(%0: !i1, %1: !i32) -> !i32 {
    %2 = scf.while iter_args(%3 = %1) -> !i32 {
      scf.condition %0, %3
    } do scope(%4)(%5) {
      scf.if %0 {
        scf.yield
      } else {
        scf.yield
      }
      scf.yield %5
    }
    return %2
  }
  module_end
}

// CHECK-NOT: scf.
// CHECK: br ^[[HEADER:bb[0-9]+]](%{{[0-9]+}} : !i32)
// CHECK-NEXT: ^[[HEADER]](%[[CARRY:[0-9]+]]: !i32):
// CHECK-NEXT: cond_br %{{[0-9]+}}, ^[[BODY:bb[0-9]+]](%[[CARRY]] : !i32), ^[[EXIT:bb[0-9]+]](%[[CARRY]] : !i32)
// CHECK-NEXT: ^[[BODY]](%[[VALUE:[0-9]+]]: !i32):
// CHECK-NEXT: cond_br %{{[0-9]+}}, ^[[HEADER]](%[[VALUE]] : !i32), ^[[HEADER]](%[[VALUE]] : !i32)
// CHECK-NEXT: ^[[EXIT]](%[[RESULT:[0-9]+]]: !i32):
// CHECK-NEXT: return %[[RESULT]]
// CHECK-NEXT: }
