// RUN: tir opt --pass builtin.func(scf-to-cfg) %s | filecheck %s

// A valued `scf.break` becomes a branch to the loop's continuation block passing
// the values its carried ports take on that exit edge.

module {
  func @loop(%0: !i1, %1: !i32) -> !i32 {
    %2 = scf.while iter_args(%3 = %1) -> !i32 {
      scf.condition %0, %3
    } do scope(%4)(%5) {
      %6 = addi %5, %5 : !i32
      scf.if %0 {
        scf.break %4, %6
      } else {
        scf.yield
      }
      scf.yield %5
    }
    return %2
  }
  module_end
}

// CHECK-NOT: scf.
// CHECK: %[[SUM:[0-9]+]] = addi
// CHECK-NEXT: cond_br %{{[0-9]+}}, ^[[EXIT:bb[0-9]+]](%[[SUM]] : !i32), ^bb{{[0-9]+}}(%{{[0-9]+}} : !i32)
// CHECK: ^[[EXIT]](%[[RESULT:[0-9]+]]: !i32):
// CHECK-NEXT: return %[[RESULT]]
