// RUN: tir opt --pass mem2reg %s | filecheck %s

// The shape a structured early return leaves behind: a flag slot the loop
// condition reads, a value slot written under a guard inside the loop, and a
// read of both after it. Both slots promote — the flag through a carried port
// the condition consumes, the value through a second port.

module {
  func @find(%0: !i1, %1: !i32) -> !i32 {
    %2 = ptr.alloca {size = 1, align = 1} : !ptr.p<!i1>
    %3 = ptr.alloca {size = 4, align = 4} : !ptr.p<!i32>
    %4 = constant {value = 0} : !i1
    ptr.store %4, %2
    scf.while {
      %5 = ptr.load %2 : !i1
      scf.condition %5
    } do {
      scf.if %0 {
        ptr.store %1, %3
        %6 = constant {value = 1} : !i1
        ptr.store %6, %2
        scf.yield
      } else {
        scf.yield
      }
      scf.yield
    }
    %7 = ptr.load %3 : !i32
    return %7
  }
  module_end
}

// CHECK-LABEL: func @find
// CHECK-NOT: ptr.store
// CHECK: %{{[0-9]+}}, %[[VALUE:[0-9]+]] = scf.while iter_args(%[[FLAG:[0-9]+]] = %{{[0-9]+}}, %{{[0-9]+}} = %{{[0-9]+}}) -> !i1, !i32 {
// CHECK-NEXT: scf.condition %[[FLAG]], %[[FLAG]], %{{[0-9]+}}
// CHECK: %{{[0-9]+}}, %{{[0-9]+}} = scf.if %0 -> !i1, !i32 {
// CHECK: return %[[VALUE]]
