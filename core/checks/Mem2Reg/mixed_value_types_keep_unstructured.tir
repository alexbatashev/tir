// RUN: tir opt --pass mem2reg --verify %s | filecheck %s

// The same rule on the dominance-based path: forwarding the stored pointer to
// the load would retype the returned value, so the slot stays in memory.

module {
  func @mixed(%0: !ptr.p<!unit>) -> !ptr.p {
    %1 = ptr.alloca {size = 8, align = 8} : !ptr.p
    ptr.store %0, %1
    br ^bb1
  ^bb1:
    %2 = ptr.load %1 : !ptr.p
    return %2
  }
  module_end
}

// CHECK-LABEL: func @mixed
// CHECK: ptr.alloca
// CHECK: ptr.store
// CHECK: ptr.load
