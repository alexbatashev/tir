// RUN: tir opt --pass mem2reg %s | filecheck %s

// Both arms define the slot, so the value merges through the conditional: the
// `scf.if` grows one result and each arm yields the value it stored.

module {
  func @both(%0: !i1, %1: !i32, %2: !i32) -> !i32 {
    %3 = ptr.alloca {size = 4, align = 4} : !ptr.p<!i32>
    scf.if %0 {
      ptr.store %1, %3
      scf.yield
    } else {
      ptr.store %2, %3
      scf.yield
    }
    %4 = ptr.load %3 : !i32
    return %4
  }
  module_end
}

// CHECK-LABEL: func @both
// CHECK-NOT: ptr.
// CHECK: %[[RESULT:[0-9]+]] = scf.if %0 -> !i32 {
// CHECK-NEXT: scf.yield %1
// CHECK-NEXT: }
// CHECK-NEXT: else {
// CHECK-NEXT: scf.yield %2
// CHECK-NEXT: }
// CHECK-NEXT: return %[[RESULT]]
