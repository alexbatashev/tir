// RUN: tir opt --pass mem2reg --verify %s | filecheck %s

// Nothing defines the slot before the conditional, so the arm that does not
// store has no value to yield. With no `undef` operation to name an
// indeterminate value, the pass materializes one by re-reading the untouched
// allocation; the allocation therefore survives, but all other traffic is gone.

module {
  func @guarded(%0: !i1, %1: !i32) -> !i32 {
    %2 = ptr.alloca {size = 4, align = 4} : !ptr.p<!i32>
    scf.if %0 {
      ptr.store %1, %2
      scf.yield
    } else {
      scf.yield
    }
    %3 = ptr.load %2 : !i32
    return %3
  }
  module_end
}

// CHECK-LABEL: func @guarded
// CHECK-NEXT: %[[SLOT:[0-9]+]] = ptr.alloca
// CHECK-NEXT: %[[UNINIT:[0-9]+]] = ptr.load %[[SLOT]]
// CHECK-NEXT: %[[RESULT:[0-9]+]] = scf.if %0 -> !i32 {
// CHECK-NEXT: scf.yield %1
// CHECK-NEXT: }
// CHECK-NEXT: else {
// CHECK-NEXT: scf.yield %[[UNINIT]]
// CHECK-NEXT: }
// CHECK-NEXT: return %[[RESULT]]
// CHECK-NOT: ptr.store
