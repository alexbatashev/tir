// RUN: tir opt --pass mem2reg %s | filecheck %s

// The shape a structured early return out of a loop leaves behind: the return
// value written under a guard, the flag tested right after, and an `scf.break`
// leaving the loop when it is raised. Both slots promote — the flag through one
// carried port, the value through a second — and the break carries them out.

module {
  func @find(%0: !i1, %1: !i32) -> !i32 {
    %2 = ptr.alloca {size = 1, align = 1} : !ptr.p<!i1>
    %3 = ptr.alloca {size = 4, align = 4} : !ptr.p<!i32>
    %4 = constant {value = 0} : !i1
    ptr.store %4, %2
    scf.while {
      scf.condition %0
    } do scope(%5) {
      scf.if %0 {
        ptr.store %1, %3
        %6 = constant {value = 1} : !i1
        ptr.store %6, %2
        scf.yield
      } else {
        scf.yield
      }
      %7 = ptr.load %2 : !i1
      scf.if %7 {
        scf.break %5
      } else {
        scf.yield
      }
      scf.yield
    }
    %8 = ptr.load %3 : !i32
    return %8
  }
  module_end
}

// CHECK-LABEL: func @find
// CHECK-NOT: ptr.store
// CHECK: %{{[0-9]+}}, %[[VALUE:[0-9]+]] = scf.while iter_args(%{{[0-9]+}} = %{{[0-9]+}}, %{{[0-9]+}} = %{{[0-9]+}}) -> !i1, !i32 {
// CHECK: scf.break %{{[0-9]+}}, %{{[0-9]+}}, %{{[0-9]+}}
// CHECK: return %[[VALUE]]
