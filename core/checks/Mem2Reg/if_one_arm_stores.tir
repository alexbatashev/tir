// RUN: tir opt --pass mem2reg %s | filecheck %s

// Only the `then` arm defines the slot. The arm that does not store yields the
// value reaching the conditional, so the merge still has one value per arm.

module {
  func @one(%0: !i1, %1: !i32, %2: !i32) -> !i32 {
    %3 = ptr.alloca {size = 4, align = 4} : !ptr.p<!i32>
    ptr.store %1, %3
    scf.if %0 {
      ptr.store %2, %3
      scf.yield
    } else {
      scf.yield
    }
    %4 = ptr.load %3 : !i32
    return %4
  }
  module_end
}

// CHECK-LABEL: func @one
// CHECK-NOT: ptr.
// CHECK: %[[RESULT:[0-9]+]] = scf.if %0 -> !i32 {
// CHECK-NEXT: scf.yield %2
// CHECK-NEXT: }
// CHECK-NEXT: else {
// CHECK-NEXT: scf.yield %1
// CHECK-NEXT: }
// CHECK-NEXT: return %[[RESULT]]
