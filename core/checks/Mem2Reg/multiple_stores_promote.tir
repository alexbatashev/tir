// RUN: tir opt --pass mem2reg --verify %s | filecheck %s

// Structured SSA construction tracks the value reaching each load, so a slot
// with several stores promotes: the load reads the last stored value.

module {
  func @twostores(%0: !i32, %1: !i32) -> !i32 {
    %2 = ptr.alloca {size = 4, align = 4} : !ptr.p<!i32>
    ptr.store %0, %2
    ptr.store %1, %2
    %3 = ptr.load %2 : !i32
    return %3
  }
  module_end
}

// CHECK-LABEL: func @twostores
// CHECK-NOT: ptr.alloca
// CHECK-NOT: ptr.store
// CHECK-NOT: ptr.load
// CHECK: return %1
