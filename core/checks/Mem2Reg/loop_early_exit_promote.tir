// RUN: tir opt --pass mem2reg --verify %s | filecheck %s

// A loop body that leaves through `scf.break` never reaches its yield, so the
// break edge is where the slot's value leaves the loop: the carried port grows
// and the break carries the value reaching it.

module {
  func @early(%0: !i1, %1: !i32) -> !i32 {
    %2 = ptr.alloca {size = 4, align = 4} : !ptr.p<!i32>
    ptr.store %1, %2
    scf.while {
      scf.condition %0
    } do scope(%3) {
      ptr.store %1, %2
      scf.break %3
    }
    %4 = ptr.load %2 : !i32
    return %4
  }
  module_end
}

// CHECK-LABEL: func @early
// CHECK-NOT: ptr.
// CHECK: %[[RESULT:[0-9]+]] = scf.while iter_args(%{{[0-9]+}} = %1) -> !i32 {
// CHECK: do scope(%[[SCOPE:[0-9]+]])(%{{[0-9]+}}) {
// CHECK-NEXT: scf.break %[[SCOPE]], %1
// CHECK: return %[[RESULT]]
