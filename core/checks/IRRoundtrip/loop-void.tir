// RUN: tir opt --verify %s | filecheck %s

// A loop carrying nothing binds no ports and produces only its predicate.

module {
  %fn_main = func.func @main() {
    scf.loop {
      %0 = constant {value = 0} : !i1
      -> %0
    }
    func.return
  }
  module_end
}

// CHECK: scf.loop {
// CHECK-NEXT: %[[C:[0-9]+]] = constant {value = 0} : !i1
// CHECK-NEXT: -> %[[C]]
// CHECK-NEXT: }
