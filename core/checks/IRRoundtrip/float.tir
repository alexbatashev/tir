// RUN: tir opt %s | filecheck %s

module {
  %fn_float_demo = func.func @float_demo(%0: !f32, %1: !f32) -> !f32 {
    %2 = fp.constant {bits = 1087373312} : !f32
    %3 = fp.add %2, %0 {semantics = {exceptions = "ignore", kind = "arithmetic", nan = "any_quiet", rounding = "nearest_even", subnormals = "gradual", tininess = "after_rounding"}} : !f32
    %4 = fp.sub %3, %1 {semantics = {exceptions = "ignore", kind = "arithmetic", nan = "any_quiet", rounding = "nearest_even", subnormals = "gradual", tininess = "after_rounding"}} : !f32
    %5 = fp.mul %4, %2 {semantics = {exceptions = "ignore", kind = "arithmetic", nan = "any_quiet", rounding = "nearest_even", subnormals = "gradual", tininess = "after_rounding"}} : !f32
    %6 = fp.div %5, %1 {semantics = {exceptions = "ignore", kind = "arithmetic", nan = "any_quiet", rounding = "nearest_even", subnormals = "gradual", tininess = "after_rounding"}} : !f32
    func.return %6
  }
  %fn_small_floats = func.func @small_floats(%7: !bf16, %8: !f8e4m3, %9: !f8e5m2, %10: !f16) -> !bf16 {
    func.return %7
  }
  module_end
}

// CHECK: module {
// CHECK-NEXT: %{{[0-9]+}} = func.func @float_demo(%{{[0-9]+}}: !f32, %{{[0-9]+}}: !f32) -> !f32 {
// CHECK-NEXT: %{{[0-9]+}} = fp.constant {bits = 1087373312} : !f32
// CHECK-NEXT: %{{[0-9]+}} = fp.add %{{[0-9]+}}, %{{[0-9]+}} : !f32
// CHECK-NEXT: %{{[0-9]+}} = fp.sub %{{[0-9]+}}, %{{[0-9]+}} : !f32
// CHECK-NEXT: %{{[0-9]+}} = fp.mul %{{[0-9]+}}, %{{[0-9]+}} : !f32
// CHECK-NEXT: %{{[0-9]+}} = fp.div %{{[0-9]+}}, %{{[0-9]+}} : !f32
// CHECK-NEXT: func.return %{{[0-9]+}}
// CHECK-NEXT: }
// CHECK-NEXT: %{{[0-9]+}} = func.func @small_floats(%{{[0-9]+}}: !bf16, %{{[0-9]+}}: !f8e4m3, %{{[0-9]+}}: !f8e5m2, %{{[0-9]+}}: !f16) -> !bf16 {
// CHECK-NEXT: func.return %{{[0-9]+}}
// CHECK-NEXT: }
// CHECK-NEXT: module_end
// CHECK-NEXT: }
