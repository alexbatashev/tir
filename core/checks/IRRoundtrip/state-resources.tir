// RUN: tir opt --verify %s | filecheck %s

module {
  %fn_f = func.func @f() {
    %memory = state.entry_state : !state<memory>
    %environment = state.entry_state : !state<fp.env>
    func.return state(%memory, %environment)
  }
  module_end
}

// CHECK:      %[[M:[0-9]+]] = state.entry_state : !state<memory>
// CHECK-NEXT: %[[E:[0-9]+]] = state.entry_state : !state<fp.env>
// CHECK-NEXT: func.return state(%[[M]], %[[E]])
