// RUN: tir opt --verify %s | filecheck %s

module {
  declare @consume(!i64, !tuple<!i64, !i64>) -> !i64
  func @forward(%0: !i64, %1: !tuple<!i64, !i64>) -> !i64 argument_alignments [1, 16] {
    %2 = call @consume(%0, %1 : !i64, !tuple<!i64, !i64>) -> !i64 argument_alignments [1, 16]
    return %2
  }
  module_end
}

