// RUN: tir opt --verify %s | filecheck %s

// A theta over an unordered body: the ports are bound to their inits on the op
// line, and the body names the predicate, the values the next iteration takes,
// and the values the loop produces when it stops.

module {
  %fn_main = func.func @main(%0: !i32) -> !i32 {
    %1 = constant {value = 10} : !i32
    %2 = constant {value = 1} : !i32
    %3 = scf.loop (%4 = %0) {
      %5 = cmpi %4, %1 {predicate = "slt"} : !i1
      %6 = addi %4, %2 : !i32
      -> %5, %6, %4
    }
    func.return %3
  }
  module_end
}

// CHECK: %[[R:[0-9]+]] = scf.loop (%[[P:[0-9]+]] = %{{[0-9]+}}) {
// CHECK-NEXT: %[[C:[0-9]+]] = cmpi %[[P]], %{{[0-9]+}} {predicate = "slt"} : !i1
// CHECK-NEXT: %[[N:[0-9]+]] = addi %[[P]], %{{[0-9]+}} : !i32
// CHECK-NEXT: -> %[[C]], %[[N]], %[[P]]
// CHECK-NEXT: }
// CHECK-NEXT: func.return %[[R]]
