// RUN: tir opt --verify %s | filecheck %s

// Storage types remain distinct. Scalar fp operations intentionally support
// only the binary32 and binary64 formats owned by this stage.

module {
  %fn_f8e4m3 = func.func @f8e4m3(%0: !f8e4m3) -> !f8e4m3 {
    func.return %0
  }
  %fn_f8e5m2 = func.func @f8e5m2(%0: !f8e5m2) -> !f8e5m2 {
    func.return %0
  }
  %fn_f16 = func.func @f16(%0: !f16) -> !f16 {
    func.return %0
  }
  %fn_bf16 = func.func @bf16(%0: !bf16) -> !bf16 {
    func.return %0
  }
  %fn_f32 = func.func @f32() -> !f32 {
    %0 = fp.constant {bits = 1069547520} : !f32
    %1 = fp.add %0, %0 {semantics = {kind = "arithmetic", rounding = "nearest_even", exceptions = "ignore", nan = "any_quiet", subnormals = "gradual", tininess = "after_rounding"}} : !f32
    func.return %1
  }
  %fn_f64 = func.func @f64() -> !f64 {
    %0 = fp.constant {bits = 4609434218613702656} : !f64
    %1 = fp.add %0, %0 {semantics = {kind = "arithmetic", rounding = "nearest_even", exceptions = "ignore", nan = "any_quiet", subnormals = "gradual", tininess = "after_rounding"}} : !f64
    func.return %1
  }
  module_end
}

// CHECK-LABEL: %{{[0-9]+}} = func.func @f8e4m3(%{{[0-9]+}}: !f8e4m3) -> !f8e4m3
// CHECK-LABEL: %{{[0-9]+}} = func.func @f8e5m2(%{{[0-9]+}}: !f8e5m2) -> !f8e5m2
// CHECK-LABEL: %{{[0-9]+}} = func.func @f16(%{{[0-9]+}}: !f16) -> !f16
// CHECK-LABEL: %{{[0-9]+}} = func.func @bf16(%{{[0-9]+}}: !bf16) -> !bf16
// CHECK-LABEL: %{{[0-9]+}} = func.func @f32() -> !f32
// CHECK: %{{[0-9]+}} = fp.add
// CHECK-LABEL: %{{[0-9]+}} = func.func @f64() -> !f64
// CHECK: %{{[0-9]+}} = fp.add
