// RUN: tir interp %s | filecheck %s

// A do-while: the predicate reads what the iteration computed, so the body
// runs at least once and the loop produces the last value computed.

module {
  %fn_main = func.func @main() -> !i32 {
    %0 = constant {value = 2} : !i32
    %1 = constant {value = 100} : !i32
    %2 = scf.loop (%3 = %0) {
      %4 = muli %3, %3 : !i32
      %5 = cmpi %4, %1 {predicate = "slt"} : !i1
      -> %5, %4, %4
    }
    func.return %2
  }
  module_end
}

// CHECK: i32 256
