// RUN: tir interp %s | filecheck %s

module {
  %fn_main = func.func @main() -> !f32 {
    %0 = fp.constant {bits = 1075838976} : !f32
    %1 = fp.constant {bits = 1056964608} : !f32
    %2 = fp.add %0, %1 {semantics = {exceptions = "ignore", kind = "arithmetic", nan = "any_quiet", rounding = "nearest_even", subnormals = "gradual", tininess = "after_rounding"}} : !f32
    func.return %2
  }
  module_end
}

// CHECK: f32 3
