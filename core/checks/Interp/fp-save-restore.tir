// RUN: tir interp %s | filecheck %s

module {
  %main = func.func @main() -> !i5 {
    %env0 = state.entry_state : !state<fp.env>
    %invalid = constant {value = 16} : !i5
    %inexact = constant {value = 1} : !i5
    %env1 = fp.raise_flags %invalid state(%env0) {trapping = false}
    %snapshot, %env2 = fp.save state(%env1) : !fp.env
    %env3 = fp.raise_flags %inexact state(%env2) {trapping = false}
    %env4 = fp.restore %snapshot state(%env3)
    %flags, %env5 = fp.get_flags state(%env4) : !i5
    func.return %flags state(%env5)
  }
  module_end
}

// CHECK: i5 16
