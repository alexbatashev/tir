// RUN: tir interp %s | filecheck %s

module {
  %f = func.func @main() -> !i64 {
    %nan = fp.constant {bits = 9221120237041090561} : !f64
    %result = fp.convert %nan {semantics = {kind = "arithmetic", rounding = "nearest_even", exceptions = "ignore", nan = "canonical", subnormals = "gradual", tininess = "after_rounding"}} : !f64
    %bits = bitcast %result : !i64
    func.return %bits
  }
  module_end
}

// CHECK: !i64 9221120237041090560
