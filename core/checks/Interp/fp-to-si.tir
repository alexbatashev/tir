// RUN: tir interp %s | filecheck %s

module {
  %main = func.func @main() -> !i64 {
    %value = fp.constant {bits = 4609434218613702656} : !f64
    %integer = fp.to_si %value {semantics = {kind = "to_integer", rounding = "toward_zero", exceptions = "ignore", subnormals = "gradual", invalid = "indeterminate"}} : !i64
    func.return %integer
  }
  module_end
}

// CHECK: i64 1
