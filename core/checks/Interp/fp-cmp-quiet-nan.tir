// RUN: tir interp %s | filecheck %s

module {
  %main = func.func @main() -> !i5 {
    %env0 = state.entry_state : !state<fp.env>
    %all_flags = constant {value = 31} : !i5
    %env1 = fp.clear_flags %all_flags state(%env0)
    %qnan = fp.constant {bits = 2143289345} : !f32
    %one = fp.constant {bits = 1065353216} : !f32
    %unused, %env2 = fp.cmp %qnan, %one state(%env1) {predicate = "oeq", semantics = {exceptions = "flags"}} : !i1
    %flags, %env3 = fp.get_flags state(%env2) : !i5
    func.return %flags state(%env3)
  }
  module_end
}

// CHECK: i5 0
