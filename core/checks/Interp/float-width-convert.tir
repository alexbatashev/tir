// RUN: tir interp %s | filecheck %s

module {
  %fn_main = func.func @main() -> !f64 {
    %0 = fp.constant {bits = 4609434218613702656} : !f64
    %1 = fp.convert %0 {semantics = {exceptions = "ignore", kind = "arithmetic", nan = "any_quiet", rounding = "nearest_even", subnormals = "gradual", tininess = "after_rounding"}} : !f32
    %2 = fp.convert %1 {semantics = {exceptions = "ignore", kind = "arithmetic", nan = "any_quiet", rounding = "nearest_even", subnormals = "gradual", tininess = "after_rounding"}} : !f64
    func.return %2
  }
  module_end
}

// CHECK: f64 1.5
