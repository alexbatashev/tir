// RUN: tir interp -f tie_even %s | filecheck %s --check-prefix=TIE
// RUN: tir interp -f signed_zero %s | filecheck %s --check-prefix=ZERO
// RUN: tir interp -f subnormal %s | filecheck %s --check-prefix=SUBNORMAL
// RUN: tir interp -f infinity %s | filecheck %s --check-prefix=INFINITY
// RUN: tir interp -f nan %s | filecheck %s --check-prefix=NAN

module {
  %tie_even = func.func @tie_even() -> !i32 {
    %bits = constant {value = 4607182419068452864} : !i64
    %wide = bitcast %bits : !f64
    %narrow = fcvt %wide : !f32
    %result = bitcast %narrow : !i32
    func.return %result
  }
  %signed_zero = func.func @signed_zero() -> !i32 {
    %bits = constant {value = -9223372036854775808} : !i64
    %wide = bitcast %bits : !f64
    %narrow = fcvt %wide : !f32
    %result = bitcast %narrow : !i32
    func.return %result
  }
  %subnormal = func.func @subnormal() -> !i64 {
    %bits = constant {value = 1} : !i32
    %narrow = bitcast %bits : !f32
    %wide = fcvt %narrow : !f64
    %result = bitcast %wide : !i64
    func.return %result
  }
  %infinity = func.func @infinity() -> !i32 {
    %bits = constant {value = 9218868437227405312} : !i64
    %wide = bitcast %bits : !f64
    %narrow = fcvt %wide : !f32
    %result = bitcast %narrow : !i32
    func.return %result
  }
  %nan = func.func @nan() -> !i32 {
    %bits = constant {value = 9221120237041090626} : !i64
    %wide = bitcast %bits : !f64
    %narrow = fcvt %wide : !f32
    %result = bitcast %narrow : !i32
    func.return %result
  }
  module_end
}

// TIE: i32 1065353216
// ZERO: i32 2147483648
// SUBNORMAL: i64 3936146074321813504
// INFINITY: i32 2139095040
// NAN: i32 2143289344
