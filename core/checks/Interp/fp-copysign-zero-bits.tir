// RUN: tir interp %s | filecheck %s

module {
  %main = func.func @main() -> !i32 {
    %positive_zero = fp.constant {bits = 0} : !f32
    %negative = fp.constant {bits = 3212836864} : !f32
    %negative_zero = fp.copysign %positive_zero, %negative : !f32
    %bits = bitcast %negative_zero : !i32
    func.return %bits
  }
  module_end
}

// CHECK: i32 2147483648
