// RUN: tir interp %s | filecheck %s

module {
  %main = func.func @main() -> !i1 {
    %env0 = state.entry_state : !state<fp.env>
    %all_flags = constant {value = 31} : !i5
    %env1 = fp.clear_flags %all_flags state(%env0)
    %snan = fp.constant {bits = 2139095041} : !f32
    %zero = fp.constant {bits = 0} : !f32
    %sum, %env2 = fp.add %snan, %zero state(%env1) {semantics = {exceptions = "flags", nan = "preserve_payload"}} : !f32
    %bits = bitcast %sum : !i32
    %quiet_bits = constant {value = 2143289345} : !i32
    %quieted = cmpi %bits, %quiet_bits {predicate = "eq"} : !i1
    %flags, %env3 = fp.get_flags state(%env2) : !i5
    %invalid = constant {value = 16} : !i5
    %raised = cmpi %flags, %invalid {predicate = "eq"} : !i1
    %ok = andi %quieted, %raised : !i1
    func.return %ok state(%env3)
  }
  module_end
}

// CHECK: i1 1
