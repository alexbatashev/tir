// RUN: tir interp %s | filecheck %s

module {
  %main = func.func @main() -> !i32 {
    %one = fp.constant {bits = 1065353216} : !f32
    %half_ulp = fp.constant {bits = 864026624} : !f32
    %sum = fp.add %one, %half_ulp {semantics = {kind = "arithmetic", rounding = "toward_positive", exceptions = "ignore", nan = "preserve_payload", subnormals = "gradual", tininess = "after_rounding"}} : !f32
    %bits = bitcast %sum : !i32
    func.return %bits
  }
  module_end
}

// CHECK: i32 1065353217
