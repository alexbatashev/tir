// RUN: tir interp %s | filecheck %s

module {
  %fn_main = func.func @main() -> !i1 {
    %0 = fp.constant {bits = 1069547520} : !f32
    %1 = fp.constant {bits = 1075838976} : !f32
    %2 = fp.mul %0, %1 {semantics = {exceptions = "ignore", kind = "arithmetic", nan = "any_quiet", rounding = "nearest_even", subnormals = "gradual", tininess = "after_rounding"}} : !f32
    // 3.75 as f32, truncated toward zero.
    %3 = fp.to_si %2 {semantics = {exceptions = "ignore", invalid = "indeterminate", kind = "to_integer", rounding = "toward_zero", subnormals = "gradual"}} : !i32
    %4 = constant {value = 3} : !i32
    %5 = cmpi %3, %4 {predicate = "eq"} : !i1
    func.return %5
  }
  module_end
}

// CHECK: i1 1
