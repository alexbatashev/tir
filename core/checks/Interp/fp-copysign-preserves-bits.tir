// RUN: tir interp %s | filecheck %s

module {
  %main = func.func @main() -> !i32 {
    %payload = fp.constant {bits = 2141266757} : !f32
    %negative = fp.constant {bits = 2147483648} : !f32
    %copied = fp.copysign %payload, %negative : !f32
    %bits = bitcast %copied : !i32
    func.return %bits
  }
  module_end
}

// CHECK: i32 4288750405
