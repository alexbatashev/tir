// RUN: tir interp %s | filecheck %s

module {
  %main = func.func @main() -> !i32 {
    %env0 = state.entry_state : !state<fp.env>
    %mode = fp.rounding_constant {mode = "toward_positive"} : !fp.rounding
    %env1 = fp.set_round %mode state(%env0)
    %one = fp.constant {bits = 1065353216} : !f32
    %half_ulp = fp.constant {bits = 864026624} : !f32
    %sum, %env2 = fp.add %one, %half_ulp state(%env1) {semantics = {kind = "arithmetic", rounding = "dynamic", exceptions = "ignore", nan = "preserve_payload", subnormals = "gradual", tininess = "after_rounding"}} : !f32
    %bits = bitcast %sum : !i32
    func.return %bits state(%env2)
  }
  module_end
}

// CHECK: i32 1065353217
