// RUN: tir interp %s | filecheck %s

module {
  %main = func.func @main() -> !i1 {
    %env0 = state.entry_state : !state<fp.env>
    %upward = fp.rounding_constant {mode = "toward_positive"} : !fp.rounding
    %env1 = fp.set_round %upward state(%env0)
    %one = fp.constant {bits = 1065353216} : !f32
    %half_ulp = fp.constant {bits = 864026624} : !f32
    %up_sum, %env2 = fp.add %one, %half_ulp state(%env1) {semantics = {rounding = "dynamic"}} : !f32
    %up_bits = bitcast %up_sum : !i32
    %up_expected = constant {value = 1065353217} : !i32
    %up_ok = cmpi %up_bits, %up_expected {predicate = "eq"} : !i1
    %toward_zero = fp.rounding_constant {mode = "toward_zero"} : !fp.rounding
    %env3 = fp.set_round %toward_zero state(%env2)
    %zero_sum, %env4 = fp.add %one, %half_ulp state(%env3) {semantics = {rounding = "dynamic"}} : !f32
    %zero_bits = bitcast %zero_sum : !i32
    %zero_expected = constant {value = 1065353216} : !i32
    %zero_ok = cmpi %zero_bits, %zero_expected {predicate = "eq"} : !i1
    %fixed_sum = fp.add %one, %half_ulp : !f32
    %fixed_bits = bitcast %fixed_sum : !i32
    %fixed_ok = cmpi %fixed_bits, %zero_expected {predicate = "eq"} : !i1
    %dynamic_ok = andi %up_ok, %zero_ok : !i1
    %all_ok = andi %dynamic_ok, %fixed_ok : !i1
    func.return %all_ok state(%env4)
  }
  module_end
}

// CHECK: i1 1
