// RUN: tir opt --verify --pass builtin.func(sea-canonicalize) %s | filecheck %s

// S1: a load whose chain is a store to the same address at the same type is the
// value that store put there, so it has no operation left to rebuild. The write
// stays — the region exports the chain it produced.

module {
  func @f(%0: !ptr.p<!i32>, %1: !i32) -> !i32 {
    ptr.store %1, %0
    %2 = ptr.load %0 : !i32
    return %2
  }
  module_end
}

// CHECK-LABEL: func @f
// CHECK-NEXT: ptr.store %1, %0
// CHECK-NEXT: return %1
