// RUN: tir opt --verify --pass builtin.func(sea-roundtrip) %s | filecheck %s

// A value-producing `scf.if` is a γ whose outputs are its results followed by
// the state edge; each arm's yield becomes that region's result tuple.

module {
  func @f(%0: !i1, %1: !i32, %2: !i32) -> !i32 {
    %3 = scf.if %0 -> !i32 {
      %4 = addi %1, %2 : !i32
      scf.yield %4
    } else {
      %5 = muli %1, %2 : !i32
      scf.yield %5
    }
    return %3
  }
  module_end
}

// CHECK-LABEL: func @f
// CHECK-NEXT: %[[R:[0-9]+]] = scf.if %0 -> !i32 {
// CHECK-NEXT: %[[T:[0-9]+]] = addi %1, %2 : !i32
// CHECK-NEXT: scf.yield %[[T]]
// CHECK-NEXT: }
// CHECK-NEXT: else {
// CHECK-NEXT: %[[E:[0-9]+]] = muli %1, %2 : !i32
// CHECK-NEXT: scf.yield %[[E]]
// CHECK-NEXT: }
// CHECK-NEXT: return %[[R]]
