// RUN: tir opt --verify --pass builtin.func(sea-canonicalize) %s | filecheck %s

// The e-graph view over the λ body proves `x + 0` is `x`, and the commit lands
// the extraction as the whole body: the addition and the zero it read are gone,
// and the multiplication that survived kept its operands.

module {
  func @f(%0: !i32, %1: !i32) -> !i32 {
    %2 = muli %0, %1 : !i32
    %3 = constant {value = 0} : !i32
    %4 = addi %2, %3 : !i32
    return %4
  }
  module_end
}

// CHECK-LABEL: func @f
// CHECK-NEXT: %[[MUL:[0-9]+]] = muli %0, %1 : !i32
// CHECK-NEXT: return %[[MUL]]
