// RUN: tir opt --verify --pass builtin.func(sea-roundtrip) %s | filecheck %s

// Straight-line code round-trips through the sea unchanged: one simple node per
// operation, threaded on the conservative state edge, destructed in the same
// order.

module {
  func @f(%0: !i32, %1: !i32) -> !i32 {
    %2 = muli %0, %1 : !i32
    %3 = constant {value = 1} : !i32
    %4 = addi %2, %3 : !i32
    return %4
  }
  module_end
}

// CHECK-LABEL: func @f
// CHECK-NEXT: %[[MUL:[0-9]+]] = muli %0, %1 : !i32
// CHECK-NEXT: %[[ONE:[0-9]+]] = constant {value = 1} : !i32
// CHECK-NEXT: %[[SUM:[0-9]+]] = addi %[[MUL]], %[[ONE]] : !i32
// CHECK-NEXT: return %[[SUM]]
