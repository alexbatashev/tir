// RUN: tir opt --verify --pass builtin.func(sea-roundtrip) %s | filecheck %s

// A resultless `scf.if` is a two-way γ carrying only the state edge. Region 1 is
// the `then` arm and region 0 the `else` arm, so the arms come back in place.

module {
  func @f(%0: !i1, %1: !ptr.p<!i32>, %2: !i32) {
    scf.if %0 {
      ptr.store %2, %1
      scf.yield
    } else {
      scf.yield
    }
    return
  }
  module_end
}

// CHECK-LABEL: func @f
// CHECK-NEXT: scf.if %0 {
// CHECK-NEXT: ptr.store %2, %1
// CHECK-NEXT: scf.yield
// CHECK-NEXT: }
// CHECK-NEXT: else {
// CHECK-NEXT: scf.yield
// CHECK-NEXT: }
// CHECK-NEXT: return
