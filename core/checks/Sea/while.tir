// RUN: tir opt --verify --pass builtin.func(sea-roundtrip) %s | filecheck %s

// θ is tail controlled, so a pre-tested `scf.while` normalizes to γ-wrapping-θ:
// the condition is evaluated once up front to pick the γ arm, and once more at
// the end of every iteration to produce the θ continuation predicate. Destructed
// back to scf, that is `scf.if { scf.while … } else { the initial values }`,
// with the θ spelled as the `do`-shaped while its semantics match.

module {
  func @f(%0: !i1, %1: !i32) -> !i32 {
    %2 = scf.while iter_args(%3 = %1) -> !i32 {
      scf.condition %0, %3
    } do (%4) {
      %5 = addi %4, %4 : !i32
      scf.yield %5
    }
    return %2
  }
  module_end
}

// CHECK-LABEL: func @f
// CHECK-NEXT: %[[R:[0-9]+]] = scf.if %0 -> !i32 {
// CHECK-NEXT: %[[L:[0-9]+]], %{{[0-9]+}} = scf.while iter_args(%{{[0-9]+}} = %1, %{{[0-9]+}} = %0) -> !i32, !i1 {
// CHECK-NEXT: %[[T:[0-9]+]] = constant {value = 1} : !i1
// CHECK-NEXT: scf.condition %[[T]]
// CHECK-NEXT: }
// CHECK-NEXT: do scope(%[[SCOPE:[0-9]+]])(%[[ACC:[0-9]+]], %[[INV:[0-9]+]]) {
// CHECK-NEXT: %[[SUM:[0-9]+]] = addi %[[ACC]], %[[ACC]] : !i32
// CHECK-NEXT: scf.if %[[INV]] {
// CHECK-NEXT: scf.yield
// CHECK-NEXT: }
// CHECK-NEXT: else {
// CHECK-NEXT: scf.break %[[SCOPE]], %[[SUM]], %[[INV]]
// CHECK-NEXT: }
// CHECK-NEXT: scf.yield %[[SUM]], %[[INV]]
// CHECK-NEXT: }
// CHECK-NEXT: scf.yield %[[L]]
// CHECK-NEXT: }
// CHECK-NEXT: else {
// CHECK-NEXT: scf.yield %1
// CHECK-NEXT: }
// CHECK-NEXT: return %[[R]]
