// RUN: tir opt --verify --pass builtin.func(sea-roundtrip) %s | filecheck %s

// A `do`-shaped `scf.while` — a constantly true condition region, which is what
// fcc's `do` lowering emits — is already tail controlled. It raises to a plain θ
// with no wrapping γ, so no `scf.if` appears around the loop.

module {
  func @f(%0: !i1, %1: !i32) -> !i32 {
    %2 = scf.while iter_args(%3 = %1) -> !i32 {
      %4 = constant {value = 1} : !i1
      scf.condition %4, %3
    } do scope(%5)(%6) {
      %7 = addi %6, %6 : !i32
      scf.if %0 {
        scf.yield
      } else {
        scf.break %5, %7
      }
      scf.yield %7
    }
    return %2
  }
  module_end
}

// CHECK-LABEL: func @f
// CHECK-NEXT: %[[R:[0-9]+]], %{{[0-9]+}} = scf.while iter_args(%{{[0-9]+}} = %1, %{{[0-9]+}} = %0) -> !i32, !i1 {
// CHECK-NEXT: %[[T:[0-9]+]] = constant {value = 1} : !i1
// CHECK-NEXT: scf.condition %[[T]]
// CHECK: return %[[R]]
