// RUN: tir opt --verify --pass builtin.func(sea-canonicalize) %s | filecheck %s

// A read leaves the chain it read, so the state edges do not order a load
// against the write that follows it: the schedule a commit lands is the region's
// own node order. The two addresses are unrelated, so no law fires and every
// access stays — in the order it was written. Only the pure arithmetic between
// them is canonicalized: the multiplication by one collapses.

module {
  func @f(%0: !ptr.p<!i32>, %1: !ptr.p<!i32>) -> !i32 {
    %2 = ptr.load %1 : !i32
    %3 = constant {value = 1} : !i32
    %4 = muli %2, %3 : !i32
    ptr.store %4, %0
    %5 = ptr.load %1 : !i32
    return %5
  }
  module_end
}

// CHECK-LABEL: func @f
// CHECK-NEXT: %[[FIRST:[0-9]+]] = ptr.load %1 : !i32
// CHECK-NEXT: ptr.store %[[FIRST]], %0
// CHECK-NEXT: %[[SECOND:[0-9]+]] = ptr.load %1 : !i32
// CHECK-NEXT: return %[[SECOND]]
