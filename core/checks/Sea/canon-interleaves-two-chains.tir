// RUN: tir opt --verify --pass builtin.func(sea-canonicalize) %s | filecheck %s

// S3 is structural: two non-escaping slots get two chains, so a write to one
// never appears under a read of the other and forwarding reaches straight
// through it. Both loads forward to their own slot's value even though the
// writes and reads interleave, and the writes keep the order the region gave
// them.

module {
  func @f(%0: !i32, %1: !i32) -> !i32 {
    %2 = ptr.alloca {size = 4, align = 4} : !ptr.p<!i32>
    %3 = ptr.alloca {size = 4, align = 4} : !ptr.p<!i32>
    ptr.store %0, %2
    ptr.store %1, %3
    %4 = ptr.load %2 : !i32
    %5 = ptr.load %3 : !i32
    %6 = addi %4, %5 : !i32
    return %6
  }
  module_end
}

// CHECK-LABEL: func @f
// CHECK-NOT: ptr.load
// CHECK: %[[SUM:[0-9]+]] = addi %0, %1 : !i32
// CHECK-NEXT: return %[[SUM]]
